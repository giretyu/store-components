      "$ref": "app:thefoschini.bash-store-components#/definitions/SKUSelector"
    }
  },
  "bash-shipping-simulator": {
    "component": "ShippingSimulator"
  },
  "bash-share": {
    "component": "Share"
  },
  "bash-availability-subscriber": {
    "component": "AvailabilitySubscriber"
  },
  "bash-product-specifications": {
    "component": "ProductSpecifications"
  },
  "bash-product-highlights": {
    "component": "ProductHighlights"
  },
  "bash-info-card": {
    "component": "InfoCard",
    "content": {
