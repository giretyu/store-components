      "$ref": "app:thefoschini.bash-store-components#/definitions/NotificationBar"
    }
  },
  "bash-notification.bar": {
    "component": "NotificationBar",
    "content": {
      "$ref": "app:thefoschini.bash-store-components#/definitions/NotificationBar"
    }
  },
  "bash-image": {
    "component": "Image",
    "content": {
      "$ref": "app:vtex.store-image#/definitions/Image"
    }
