    "component": "ProductSKUAttributes"
  },
  "bash-product-brand": {
    "component": "ProductBrand"
  },
  "bash-product-images": {
    "component": "ProductImages"
  },
  "bash-product-images.high-quality-image": {
    "component": "HighQualityProductImage"
  },
  "bash-product-price": {
    "component": "ProductPrice",
    "content": {
      "$ref": "app:thefoschini.bash-store-components#/definitions/ProductPrice"
    }
  },
  "bash-product-description": {
    "component": "ProductDescription",
    "content": {
      "$ref": "app:thefoschini.bash-store-components#/definitions/ProductDescription"
    }
